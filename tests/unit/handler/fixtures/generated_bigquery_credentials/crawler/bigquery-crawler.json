{
  "id": "bigquery-crawler",
  "name": "Crawler",
  "logo": "https://assets.atlan.com/assets/bigquery.svg",
  "config": {
    "properties": {
      "extraction-method": {
        "type": "conditional",
        "required": false,
        "ui": {
          "widget": "radio",
          "label": "Extraction method",
          "hidden": false,
          "help": "",
          "grid": 8
        },
        "default": "direct",
        "conditions": [
          {
            "property": "labFlag",
            "value": "SECURE_AGENT_EXTRACTION",
            "enum": [
              "direct",
              "agent"
            ],
            "enumNames": [
              "Direct",
              "Self-Deployed Runtime"
            ]
          }
        ],
        "enum": [
          "direct"
        ],
        "enumNames": [
          "Direct"
        ]
      },
      "credential-guid": {
        "type": "string",
        "required": true,
        "ui": {
          "widget": "credential",
          "label": "",
          "hidden": false,
          "help": "",
          "grid": 8,
          "credentialType": "atlan-connectors-bigquery",
          "isTestAuthenticationDisabled": false
        }
      },
      "agent-json": {
        "type": "object",
        "required": false,
        "ui": {
          "widget": "agent",
          "label": "",
          "hidden": false,
          "help": "",
          "placeholder": "Agent JSON",
          "grid": 8,
          "agentConfigs": [
            [
              "atlan-connectors-bigquery",
              {
                "properties": {
                  "basic": {
                    "properties": {
                      "username": {
                        "type": "string",
                        "required": true
                      },
                      "password": {
                        "type": "string",
                        "required": true
                      }
                    }
                  },
                  "gcp-wif": {
                    "properties": {
                      "extra": {
                        "properties": {
                          "project_id": {
                            "type": "string",
                            "required": true
                          },
                          "service_account_email": {
                            "type": "string",
                            "required": true
                          },
                          "wif_pool_provider_id": {
                            "type": "string",
                            "required": true
                          },
                          "atlan_oauth_id": {
                            "type": "string",
                            "required": true
                          },
                          "atlan_oauth_secret": {
                            "type": "string",
                            "required": true
                          }
                        }
                      }
                    }
                  }
                }
              }
            ],
            [
              "atlan-connectors-agent"
            ]
          ]
        }
      }
    },
    "anyOf": [
      {
        "properties": {
          "extraction-method": {
            "const": "direct"
          }
        },
        "required": [
          "credential-guid"
        ]
      },
      {
        "properties": {
          "extraction-method": {
            "const": "agent"
          }
        },
        "required": [
          "agent-json"
        ]
      }
    ],
    "steps": [
      {
        "title": "Credential",
        "description": "",
        "id": "credential",
        "properties": [
          "extraction-method",
          "credential-guid",
          "agent-json"
        ]
      }
    ]
  }
}
