{
  "icon": "https://assets.atlan.com/assets/bigquery.svg",
  "helpdeskLink": "",
  "logo": "https://assets.atlan.com/assets/bigquery.svg",
  "connector": "bigquery",
  "defaultConnectorType": "rest",
  "config": {
    "properties": {
      "name": {
        "type": "string",
        "required": false,
        "ui": {
          "label": "Name",
          "hidden": true,
          "placeholder": "Host Name"
        }
      },
      "connector": {
        "type": "string",
        "required": false,
        "ui": {
          "label": "Connector",
          "hidden": true,
          "placeholder": "Connector"
        }
      },
      "connectorType": {
        "type": "string",
        "required": false,
        "ui": {
          "key": "_host",
          "label": "connectorType",
          "placeholder": "connectorType",
          "hidden": true
        }
      },
      "auth-type": {
        "type": "string",
        "enum": [
          "basic",
          "gcp-wif"
        ],
        "default": "basic",
        "required": true,
        "enumNames": [
          "Service account",
          "Workload identity federation"
        ],
        "ui": {
          "widget": "radio",
          "hidden": false,
          "label": "Authentication"
        }
      },
      "basic": {
        "type": "object",
        "ui": {
          "widget": "nested",
          "label": "",
          "hidden": true,
          "nestedValue": false
        },
        "properties": {
          "username": {
            "type": "string",
            "required": true,
            "ui": {
              "widget": "input",
              "label": "Service account email",
              "hidden": false,
              "grid": 8
            }
          },
          "password": {
            "type": "string",
            "required": true,
            "ui": {
              "widget": "password",
              "label": "Service account JSON",
              "hidden": false,
              "grid": 8
            }
          },
          "extra": {
            "type": "object",
            "ui": {
              "widget": "nested",
              "label": "",
              "header": "Advanced",
              "hidden": false
            },
            "properties": {
              "project_id": {
                "type": "string",
                "required": true,
                "ui": {
                  "widget": "input",
                  "label": "Project ID",
                  "hidden": false,
                  "grid": 8
                }
              }
            }
          }
        }
      },
      "gcp-wif": {
        "type": "object",
        "ui": {
          "widget": "nested",
          "label": "",
          "hidden": true,
          "nestedValue": false
        },
        "properties": {
          "extra": {
            "type": "object",
            "ui": {
              "widget": "nested",
              "label": "",
              "header": "Advanced",
              "hidden": false
            },
            "properties": {
              "project_id": {
                "type": "string",
                "required": true,
                "ui": {
                  "widget": "input",
                  "label": "Project ID",
                  "hidden": false,
                  "grid": 8
                }
              },
              "service_account_email": {
                "type": "string",
                "required": true,
                "ui": {
                  "widget": "input",
                  "label": "Service account email",
                  "hidden": false,
                  "grid": 8
                }
              },
              "wif_pool_provider_id": {
                "type": "string",
                "required": true,
                "ui": {
                  "widget": "input",
                  "label": "WIF pool provider ID",
                  "hidden": false,
                  "grid": 8
                }
              },
              "atlan_oauth_id": {
                "type": "string",
                "required": true,
                "ui": {
                  "widget": "input",
                  "label": "Atlan OAuth client ID",
                  "hidden": false,
                  "grid": 8
                }
              },
              "atlan_oauth_secret": {
                "type": "string",
                "required": true,
                "ui": {
                  "widget": "password",
                  "label": "Atlan OAuth client secret",
                  "hidden": false,
                  "grid": 8
                }
              }
            }
          }
        }
      }
    },
    "anyOf": [
      {
        "properties": {
          "auth-type": {
            "const": "basic"
          }
        },
        "required": [
          "basic"
        ]
      },
      {
        "properties": {
          "auth-type": {
            "const": "gcp-wif"
          }
        },
        "required": [
          "gcp-wif"
        ]
      }
    ]
  }
}
