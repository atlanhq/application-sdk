{
  "_comment": "Per-datasource candidate lists mapping dataforge's raw connection fields (catalog secrets.tf outputs / vault-managed credential fields) onto the canonical E2E_SOURCE_{HOST,PORT,DATABASE,USERNAME,PASSWORD} contract consumed by connector e2e suites. Lookup order in fetch_dataforge_source.py: --field-map override > datasource entry > _default. Seeded from dataforge's externalSourceProfiles (apps/api/internal/usecase/curation_external.go) and catalog/*/secrets.tf; grow entries as connectors adopt.",
  "_default": {
    "host": ["host", "hostname", "endpoint", "internal_host"],
    "port": ["port"],
    "database": ["database", "db", "dbname"],
    "username": ["username", "user"],
    "password": ["password"]
  },
  "snowflake": {
    "host": ["account", "account_url", "host"],
    "database": ["database", "warehouse"],
    "username": ["username", "user"],
    "password": ["password", "private_key"]
  },
  "powerbi": {
    "username": ["client_id"],
    "password": ["client_secret"],
    "database": ["workspace_id"]
  },
  "salesforce": {
    "host": ["instance_url"],
    "username": ["username", "client_id"],
    "password": ["password", "client_secret"]
  },
  "databricks": {
    "host": ["server_hostname", "host"],
    "database": ["catalog"],
    "password": ["access_token"]
  },
  "bigquery": {
    "database": ["project_id"],
    "password": ["service_account_key_json"]
  },
  "dynamodb": {
    "username": ["aws_access_key_id"],
    "password": ["aws_secret_access_key"],
    "database": ["table_name"]
  },
  "looker": {
    "username": ["client_id"],
    "password": ["client_secret"]
  },
  "redash": {
    "host": ["redash_url"],
    "password": ["api_key"]
  },
  "oracle": {
    "database": ["service_name", "database"]
  },
  "mongodb": {
    "host": ["srv_address", "host"],
    "password": ["password"]
  }
}
