/// App.pkl contract exercising render-time `appName` resolution (CNCT-24).
///
/// Every node here is a **raw `DAGNode`** — the shape connector contracts
/// hand-write when they wire a QI / lineage step themselves instead of using the
/// built-in node class. That is exactly how those steps inherited `DAGNode`'s
/// `"automation-engine"` default and started filing their logs under Automation
/// Engine, and how the dead `"{app_name}"` scaffold token survived into shipped
/// manifests once the SDK stopped substituting it (#2271).
///
/// The nodes cover both corrections and, importantly, the two cases that must
/// NOT be touched: an explicitly-set `appName` on a toolkit-owned workflow, and
/// the default on a workflow Automation Engine genuinely runs.
amends "../../src/App.pkl"

import "../../src/Connectors.pkl"

name = "appname-resolution"
displayName = "App Name Resolution"
connector = Connectors.SNOWFLAKE
icon = "https://assets.atlan.com/assets/snowflake.svg"
hasCredentialConfig = false

pipeline {
  publish = null
}

extraNodes {
  // Drifted QI node: toolkit-owned workflowType, `appName` left at the DAGNode
  // default, task queue pinned to a fixed environment. Resolves to
  // "query-intelligence"; the pinned queue must survive untouched, since it
  // governs dispatch and rewriting it would move where the node runs.
  ["qi_drifted"] = new DAGNode {
    displayName = "Parse SQL Queries"
    workflowType = "QueryIntelligenceWorkflow"
    taskQueue = "atlan-query-intelligence-production"
    args = new Mapping {
      ["input_prefix"] = "$.extract.outputs.processed_queries_path"
    }
  }

  // Same workflowType, but the author named an app deliberately. Left alone —
  // the correction only fires on the untouched default.
  ["qi_explicit"] = new DAGNode {
    displayName = "Parse SQL Queries (custom worker)"
    workflowType = "QueryIntelligenceWorkflow"
    appName = "custom-qi-worker"
    taskQueue = "atlan-custom-qi-worker-{deployment_name}"
    args = new Mapping {
      ["marker"] = "explicit-appname"
    }
  }

  // Drifted lineage node, no taskQueue: the derived queue must follow the
  // resolved app, not the default, or dispatch and log identity disagree.
  ["lineage_drifted"] = new DAGNode {
    displayName = "Build Lineage"
    workflowType = "LineageWorkflow"
    args = new Mapping {
      ["marker"] = "lineage-default"
    }
  }

  // Dead scaffold placeholder: resolves to the contract `name`, including in
  // the derived task queue.
  ["placeholder"] = new DAGNode {
    displayName = "Process Metadata"
    workflowType = "appname-resolution:process-metadata"
    appName = "{app_name}"
    args = new Mapping {
      ["marker"] = "placeholder"
    }
  }

  // A workflow Automation Engine really does run. The default is correct here
  // and must not be rewritten — `automation-engine` is never suspect on its own.
  ["ae_hosted"] = new DAGNode {
    displayName = "AE-hosted Step"
    workflowType = "SomeAeHostedWorkflow"
    args = new Mapping {
      ["marker"] = "ae-hosted"
    }
  }
}

uiConfig = new UIConfig {
  tasks {
    ["Connection"] {
      inputs {
        ["connection"] = new ConnectionCreator {
          placeholderText = "Connection Name"
        }
      }
    }
  }
}
