// Tests for `treeSelection` on `APITree` and apitree `ConditionalInput`.
//
// Background: tree widgets render as `Annotated[dict[str, Any], MaxItems(1000)]`,
// which the SDK's payload-safety check refuses at import, so apps patched the
// generated class to opt out of the check. `treeSelection = true` types the field
// as the SDK's payload-safe `TreeSelection` instead; the value keeps the widget's
// nested-dict shape, so nothing else about the field changes.

amends "pkl:test"

import "../src/App.pkl" as App
import "../src/Connectors.pkl"

local function treeApp(include: App.UIElement) = (App) {
  name = "tree-selection-test"
  displayName = "Tree Selection Test"
  connector = Connectors.API
  icon = "https://example.com/icon.svg"
  credentialConnectorType = "rest"

  credentialAuthOptions {
    ["basic"] = new App.AuthOption {
      label = "Basic"
      fields {
        new App.FieldSpec { name = "username"; displayName = "Username" }
        new App.FieldSpec { name = "password"; displayName = "Password"; sensitive = true }
      }
    }
  }

  uiConfig = new App.UIConfig {
    tasks {
      ["Metadata"] {
        inputs {
          ["include-components"] = include
        }
      }
    }
  }
}

local function conditional(tree: Boolean, base: String) = new App.ConditionalInput {
  title = "Include Components"
  baseWidgetType = base
  connectorConfig = "atlan-connectors-tree-selection-test"
  credentialRef = "credential-guid"
  additionalProperties = new Dynamic { type = "array" }
  treeSelection = tree
}

local function apiTree(tree: Boolean) = new App.APITree {
  title = "Include Components"
  credentialType = "atlan-connectors-tree-selection-test"
  treeSelection = tree
}

local function filterApp(include: App.UIElement, exclude: App.UIElement) = (treeApp(include)) {
  uiConfig {
    tasks {
      ["Metadata"] {
        inputs {
          ["include-filter"] = include
          ["exclude-filter"] = exclude
        }
      }
    }
  }
}

local function inputPy(app) = app.output.files["app/generated/_input.py"].text
local function configJson(app) = app.output.files["app/generated/tree-selection-test.json"].text

local conditionalOn = treeApp(conditional(true, "apitree"))
local conditionalOff = treeApp(conditional(false, "apitree"))
local apiTreeOn = treeApp(apiTree(true))
local apiTreeOff = treeApp(apiTree(false))
local filterOn = filterApp(conditional(true, "apitree"), conditional(true, "apitree"))
local filterOff = filterApp(conditional(false, "apitree"), conditional(false, "apitree"))
local filterApiTreeOn = filterApp(apiTree(true), apiTree(true))
local includeFilterOnly = (treeApp(apiTree(false))) {
  uiConfig { tasks { ["Metadata"] { inputs { ["include-filter"] = conditional(true, "apitree") } } } }
}
local treeIncludeTextExclude = filterApp(apiTree(true), new App.TextInput { title = "Exclude regex" })
local treeIncludeSqlTreeExclude = filterApp(apiTree(true), conditional(false, "sqltree"))
local filterMixed = filterApp(conditional(true, "apitree"), conditional(false, "apitree"))

facts {
  ["Default: tree widgets keep the existing dict[str, Any] type"] {
    inputPy(conditionalOff).contains("include_components: Annotated[dict[str, Any], MaxItems(1000)]")
    inputPy(apiTreeOff).contains("include_components: Annotated[dict[str, Any], MaxItems(1000)]")
    !inputPy(conditionalOff).contains("TreeSelection")
  }

  ["ConditionalInput apitree: typed as TreeSelection and imported from the SDK"] {
    inputPy(conditionalOn).contains("include_components: TreeSelection = Field(default_factory=dict)")
    inputPy(conditionalOn).contains("from application_sdk.contracts.types import TreeSelection\n")
    !inputPy(conditionalOn).contains("dict[str, Any]")
  }

  ["APITree: typed as TreeSelection"] {
    inputPy(apiTreeOn).contains("include_components: TreeSelection = Field(default_factory=dict)")
    !inputPy(apiTreeOn).contains("dict[str, Any]")
  }

  ["The class needs no payload-safety opt-out"] {
    inputPy(conditionalOn).contains("\nclass AppInputContract(ExtractionInput):\n")
    !inputPy(conditionalOn).contains("allow_unbounded_fields")
  }

  ["Only the Python type changes: workflow config and manifest are identical"] {
    configJson(conditionalOn) == configJson(conditionalOff)
    configJson(apiTreeOn) == configJson(apiTreeOff)
    conditionalOn.output.files["app/generated/manifest.json"].text
      == conditionalOff.output.files["app/generated/manifest.json"].text
  }

  ["Filter widgets without treeSelection keep ExtractionInput"] {
    inputPy(filterOff).contains("\nclass AppInputContract(ExtractionInput):\n")
    inputPy(filterOff).contains("from application_sdk.templates.contracts import ExtractionInput\n")
    !inputPy(filterOff).contains("TreeSelectionExtractionInput")
  }

  ["Filter widgets with treeSelection extend TreeSelectionExtractionInput"] {
    inputPy(filterOn).contains("\nclass AppInputContract(TreeSelectionExtractionInput):\n")
    inputPy(filterOn).contains("from application_sdk.templates.contracts import TreeSelectionExtractionInput\n")
    inputPy(filterApiTreeOn).contains("\nclass AppInputContract(TreeSelectionExtractionInput):\n")
  }

  ["The filters stay inherited: no field is generated for them"] {
    !inputPy(filterOn).contains("include_filter")
    !inputPy(filterOn).contains("exclude_filter")
  }

  ["One filter widget with treeSelection is enough"] {
    inputPy(includeFilterOnly).contains("\nclass AppInputContract(TreeSelectionExtractionInput):\n")
  }

  ["Filter tree widgets that disagree on treeSelection are refused"] {
    module.catch(() -> inputPy(filterMixed))
      .contains("Filter widget(s) exclude-filter must be tree widgets that also set treeSelection, or a TextInput.")
  }

  ["A non-tree, non-text filter widget beside a tree filter is refused"] {
    module.catch(() -> inputPy(treeIncludeSqlTreeExclude))
      .contains("Filter widget(s) exclude-filter must be tree widgets that also set treeSelection, or a TextInput.")
  }

  ["Filter widgets without treeSelection are not checked"] {
    inputPy(filterApp(apiTree(false), conditional(false, "sqltree")))
      .contains("\nclass AppInputContract(ExtractionInput):\n")
  }

  ["A tree include filter beside a non-tree exclude widget is allowed"] {
    inputPy(treeIncludeTextExclude).contains("\nclass AppInputContract(TreeSelectionExtractionInput):\n")
  }

  ["The tree-filters example extends TreeSelectionExtractionInput"] {
    read("../examples/tree-filters/app/generated/_input.py").text
      .contains("\nclass AppInputContract(TreeSelectionExtractionInput):\n")
  }

  ["Filter treeSelection: workflow config and manifest are identical"] {
    configJson(filterOn) == configJson(filterOff)
    filterOn.output.files["app/generated/manifest.json"].text
      == filterOff.output.files["app/generated/manifest.json"].text
  }

  ["treeSelection is refused on a non-apitree ConditionalInput"] {
    module.catch(() -> inputPy(treeApp(conditional(true, "sqltree"))))
      .contains("treeSelection applies only to baseWidgetType = \"apitree\"")
  }

  // The refusal must not depend on the field being emitted into _input.py.
  ["treeSelection is refused even when the field is excluded from _input.py"] {
    local excluded = (conditional(true, "sqltree")) { includeInInput = false }
    module.catch(() -> treeApp(excluded).output.files.keys)
      .contains("treeSelection applies only to baseWidgetType = \"apitree\"")
  }
}
