/// `deploy.dapr.secretstore` defaults to whether the app resolves credentials.
///
/// Every `deploy` block emits a full `dapr:` block (objectstore defaults to
/// true), and the chart loads only the components that block enables. A
/// credential app that rendered `secretstore: false` therefore got no secret
/// store, and every credential lookup failed with HTTP 500.
amends "pkl:test"

import "../src/App.pkl" as App
import "../src/Connectors.pkl"
import "../examples/credential-configs/app.pkl" as CredentialBundle
import "../examples/system-app/app.pkl" as SystemApp

local function appWith(creds: Boolean, deployCfg: App.DeployConfig?) = (App) {
  name = "dapr-secret-test"
  displayName = "Dapr Secret Test"
  icon = "https://assets.atlan.com/assets/dummy.svg"
  connector = if (creds) Connectors.TRINO else null
  hasCredentialConfig = creds
  pipeline { publish = null }
  deploy = deployCfg
  uiConfig = new App.UIConfig {
    tasks {
      ["Settings"] {
        inputs {
          ["target"] = new App.TextInput { title = "Target" }
        }
      }
    }
  }
}

local function daprOf(a) = a.output.files["atlan.yaml"].value["deploy"]["dapr"]

local credsEmpty = appWith(true, new App.DeployConfig {})
local noCredsEmpty = appWith(false, new App.DeployConfig {})
local credsExplicitFalse = appWith(true, new App.DeployConfig { dapr { secretstore = false } })
// A bundle root with no credential of its own, whose entrypoints carry one.
local bundle = (CredentialBundle) { deploy = new App.DeployConfig {} }
// A system app: `hasCredentialConfig` defaults to false.
local systemApp = (SystemApp) { deploy = new App.DeployConfig {} }
local noCredsExplicitTrue = appWith(false, new App.DeployConfig { dapr { secretstore = true } })

facts {
  ["DaprComponents.secretstore is unset by default"] {
    new App.DaprComponents {}.secretstore == null
  }

  ["a credential app with an empty deploy block emits secretstore: true"] {
    daprOf(credsEmpty)["secretstore"] == true
    daprOf(credsEmpty)["objectstore"] == true
  }

  ["a non-credential app emits secretstore: false"] {
    daprOf(noCredsEmpty)["secretstore"] == false
  }

  ["a bundle counts its entrypoints' credentials"] {
    CredentialBundle.hasCredentialConfig == false
    daprOf(bundle)["secretstore"] == true
  }

  ["a system app emits secretstore: false"] {
    daprOf(systemApp)["secretstore"] == false
  }

  ["an explicit secretstore = false is rendered as written"] {
    daprOf(credsExplicitFalse)["secretstore"] == false
  }

  ["an explicit secretstore = true is rendered as written"] {
    daprOf(noCredsExplicitTrue)["secretstore"] == true
  }
}
