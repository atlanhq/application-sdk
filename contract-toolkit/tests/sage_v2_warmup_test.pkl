/// Tests for the `SageV2.warmup` declaration (Widgets.pkl + Config.pkl parity).
///
/// The flag tells the setup UI to run the warmup flow (poll `/warmup`, then
/// `/check` with `tiers=["warmup"]`) before it calls anything. Default `false`
/// must leave the rendered widget byte-identical to the pre-flag output; `true`
/// adds `ui.warmup = true` and nothing else.
amends "pkl:test"

import "pkl:json"
import "../src/App.pkl" as App
import "../src/Config.pkl"
import "../src/Connectors.pkl"
import "../src/NativeApp.pkl"
import "../src/Widgets.pkl" as Widgets

local renderer = new JsonRenderer {}
local function parse(text: String) = new json.Parser { useMapping = true }.parse(text)

/// The widget's rendering before the flag existed, captured from the
/// pre-change toolkit. Both modules render the same document.
local preFlagSageV2Json = """
  {
    "type": "string",
    "required": false,
    "ui": {
      "widget": "sageV2",
      "label": "Preflight",
      "hidden": false,
      "help": "",
      "grid": 8
    }
  }

  """

local widgetsDefault = renderer.renderDocument(new Widgets.SageV2 { title = "Preflight" })
local configDefault = renderer.renderDocument(new Config.SageV2 { title = "Preflight" })
local widgetsExplicitOff = renderer.renderDocument(new Widgets.SageV2 { title = "Preflight"; warmup = false })
local widgetsOn = parse(renderer.renderDocument(new Widgets.SageV2 { title = "Preflight"; warmup = true }))
local configOn = parse(renderer.renderDocument(new Config.SageV2 { title = "Preflight"; warmup = true }))
local widgetsOffParsed = parse(widgetsDefault)

local appWithWarmup = (App) {
  name = "sage-warmup-test"
  displayName = "Sage Warmup Test"
  connector = Connectors.POSTGRES
  icon = "https://example.com/icon.svg"

  uiConfig = new App.UIConfig {
    tasks {
      ["Connection"] {
        inputs {
          ["preflight-check"] = new App.SageV2 { title = ""; warmup = true }
        }
      }
    }
  }
}

local nativeWithWarmup = (NativeApp) {
  name = "native-sage-warmup-test"
  displayName = "Native Sage Warmup Test"
  connector = Connectors.POSTGRES
  icon = "https://example.com/icon.svg"
  workflowType = "NativeSageWarmupTestWorkflow"

  uiConfig = new Config.UIConfig {
    tasks {
      ["Connection"] {
        inputs {
          ["preflight-check"] = new Config.SageV2 { title = ""; warmup = true }
        }
      }
    }
  }
}

local appConfig = parse(appWithWarmup.output.files["app/generated/sage-warmup-test.json"].text)
local nativeConfig = parse(nativeWithWarmup.output.files["native-sage-warmup-test.json"].text)

facts {
  ["default warmup renders byte-identical to the pre-flag widget"] {
    widgetsDefault == preFlagSageV2Json
    configDefault == preFlagSageV2Json
    widgetsExplicitOff == preFlagSageV2Json
  }

  ["warmup = true adds ui.warmup and nothing else"] {
    widgetsOn["ui"]["warmup"] == true
    widgetsOn["ui"].toMap().remove("warmup") == widgetsOffParsed["ui"].toMap()
    widgetsOn.toMap().remove("ui") == widgetsOffParsed.toMap().remove("ui")
    configOn == widgetsOn
  }

  ["App.pkl carries the flag into the generated workflow config"] {
    appConfig["config"]["properties"]["preflight-check"]["ui"]["widget"] == "sageV2"
    appConfig["config"]["properties"]["preflight-check"]["ui"]["warmup"] == true
  }

  ["NativeApp.pkl carries the flag into the generated workflow config"] {
    nativeConfig["config"]["properties"]["preflight-check"]["ui"]["widget"] == "sageV2"
    nativeConfig["config"]["properties"]["preflight-check"]["ui"]["warmup"] == true
  }
}
