// Regression guards for per-node `appName` on the legacy NativeApp module.
//
// NativeApp.pkl is frozen reference material, but ~all pre-App.pkl connector
// apps still `amends "@app-contract-toolkit/NativeApp.pkl"` (or NativeAppBundle),
// and it is the path on which most QueryIntelligenceNode / LineageNode routing
// actually runs. `app_name` in the generated AE manifest drives failure
// attribution in observability (ClickHouse `failure_app`); `taskQueue` — not
// `appName` — governs dispatch, so these specialised nodes must override the
// `DAGNode` default of "automation-engine" with their own app identity.
//
// No fact asserted these values before, which is exactly how QI and Lineage
// silently drifted to "automation-engine" and masked their failures behind the
// wrong app. These guards catch any future silent revert to the base default.

amends "pkl:test"

import "pkl:json"
import "../src/NativeApp.pkl" as NativeApp
import "fixtures/native_app_pipeline.pkl" as nativeApp
import "fixtures/native_app_nested_generic.pkl" as nativeAppNested

// The generated AE-manifest extract node for a NativeApp contract. `app_name`
// must be baked from the contract `name` — the SDK stopped substituting a
// runtime `{app_name}` placeholder (#2271), so a literal placeholder here
// freezes into the DAG and strips failure attribution in Pulse (HYP-1954).
local dag =
  let (text = nativeApp.output.files["manifest.json"].text)
    new json.Parser { useMapping = true }.parse(text)["dag"]
local extractNode = dag["extract"]
// Publish node from the same manifest — renderNodeArgs' PublishNode (if) branch.
local publishManifestNode = dag["publish"]

// A second contract with flatManifestArgs=false and a generic (QI) node, so we
// exercise renderNodeArgs' GENERIC (else) branch AND the nested manifest shape.
local nestedDag =
  let (text = nativeAppNested.output.files["manifest.json"].text)
    new json.Parser { useMapping = true }.parse(text)["dag"]

local qiNode = new NativeApp.QueryIntelligenceNode {
  vendorName = "athena"
  sqlKey = "QUERY_TEXT"
}

local lineageNode = new NativeApp.LineageNode {
  connectorName = "postgres"
  sqlUnquotedCase = "upper"
  ignoreAllCase = false
}

local publishNode = new NativeApp.PublishNode {}
local lineagePublishNode = new NativeApp.LineagePublishNode {}
local popularityNode = new NativeApp.PopularityNode {}

facts {
  ["QueryIntelligenceNode identifies the query-intelligence app"] {
    qiNode.appName == "query-intelligence"
  }

  ["LineageNode identifies the lineage app"] {
    lineageNode.appName == "lineage"
  }

  // Nodes that were already correct — guard them so they cannot silently drift
  // to the DAGNode "automation-engine" default the way QI and Lineage did.
  ["PublishNode identifies the publish app"] {
    publishNode.appName == "publish"
  }

  // LineagePublishNode dispatches to the general publish app (it emits a
  // PublishWorkflow, not a LineageWorkflow), not a dedicated "lineage" app.
  ["LineagePublishNode identifies the publish app"] {
    lineagePublishNode.appName == "publish"
  }

  ["PopularityNode identifies the popularity app"] {
    popularityNode.appName == "popularity"
  }

  // Extract node bakes app_name from the contract `name` — not a literal
  // "{app_name}" placeholder. The SDK no longer fills that placeholder at
  // serve time (#2271); a literal here would freeze into the AE DAG and drop
  // failure attribution in Pulse (HYP-1954). Guards the top-level and inputs
  // copies the frozen manifests of dbt/postgres/quicksight actually carried.
  ["extract node bakes app_name from the contract name"] {
    extractNode["app_name"] == "native-app-pipeline"
  }

  ["extract node inputs bake app_name from the contract name"] {
    extractNode["inputs"]["app_name"] == "native-app-pipeline"
  }

  // CNCT-93: the node's own app_name must also ride INSIDE inputs.args, where
  // the SDK log interceptor reads it (over the connector-level
  // ATLAN_APPLICATION_NAME env) so per-entrypoint logs attribute to the right
  // app. Emitted unconditionally — outside the flatManifestArgs branches — so
  // both the flat and nested manifest shapes carry it.
  ["extract node args carry app_name for the SDK log interceptor"] {
    extractNode["inputs"]["args"]["app_name"] == "native-app-pipeline"
  }

  // CNCT-93: renderNodeArgs stamps app_name for every non-extract node too, on
  // BOTH branches. Without these facts the suite would stay green if publish /
  // generic nodes silently stopped emitting app_name (the exact silent-drift
  // this PR closes). PublishNode → the `if` (publish) branch:
  ["publish node args carry app_name (renderNodeArgs publish branch)"] {
    publishManifestNode["inputs"]["args"]["app_name"] == "publish"
    publishManifestNode["inputs"]["args"]["app_name"] == publishManifestNode["app_name"]
  }

  // A generic (QueryIntelligenceNode) node → the `else` branch. Sourced from a
  // flatManifestArgs=false contract, so this also proves the NESTED manifest
  // shape carries app_name (closing the prose-only "both shapes" claim above).
  ["generic node args carry app_name (renderNodeArgs generic branch, nested shape)"] {
    nestedDag["qi"]["inputs"]["args"]["app_name"] == "query-intelligence"
    nestedDag["qi"]["inputs"]["args"]["app_name"] == nestedDag["qi"]["app_name"]
  }

  // Nested shape (flatManifestArgs=false) extract node still carries app_name.
  ["extract node args carry app_name in the nested manifest shape"] {
    nestedDag["extract"]["inputs"]["args"]["app_name"] == "native-nested-generic"
  }

  // CNCT-93 collision guard: when a node's args ALREADY set app_name, the stamp
  // must be guarded so (a) generation does not crash with a Pkl duplicate-key
  // error and (b) the author's value wins over node.appName. That the entire
  // manifest above parsed at all already proves (a); this asserts (b).
  ["author-set args.app_name is respected, not clobbered or crashed"] {
    nestedDag["author_app"]["inputs"]["args"]["app_name"] == "author-chosen"
    nestedDag["author_app"]["app_name"] == "custom-worker"
  }
}
