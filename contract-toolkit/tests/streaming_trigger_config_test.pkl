// Tests for streaming dispatch config on event triggers.
//
// AE grew a second dispatch shell for event triggers: instead of firing a fresh
// top-level run per ingest batch, a `streaming_enabled` trigger signals each event
// into a persistent shard that runs the DAG inline. The knobs live on AE's
// `TriggerConfig`, so the toolkit has to be able to render them — without them an
// app has no way to opt in from its contract.
//
// The feature lives in BOTH schemas (App.pkl and NativeApp.pkl) while the toolkit
// migrates from NativeApp.pkl to App.pkl, so every fact below is asserted twice.
//
// The load-bearing invariant is the last group: a trigger that does NOT opt in must
// render byte-identically to before this feature existed, so no deployed manifest
// changes shape on a toolkit bump.

amends "pkl:test"

import "pkl:json"
import "../src/App.pkl" as App
import "../src/NativeApp.pkl" as NativeApp
import "../src/Connectors.pkl"

local parser = new json.Parser { useMapping = true }

// Every assertion below reads the same place: the first (only) event trigger's
// rendered trigger_config. Factored out so the schema pairs stay readable.
// App.pkl emits the manifest under app/generated/; NativeApp.pkl emits it at the
// root — hence the path argument rather than one hard-coded key.
local function triggerCfgAt(app, path: String) =
  parser.parse(app.output.files!![path].text)["triggers"]["events"][0]["trigger_config"]

local function appCfg(app) = triggerCfgAt(app, "app/generated/manifest.json")

local function nativeCfg(app) = triggerCfgAt(app, "manifest.json")

// The DAG's extract node — where the streaming/batch workflow-type split shows up.
local function dagAt(app, path: String) =
  parser.parse(app.output.files!![path].text)["dag"]

local function appDag(app) = dagAt(app, "app/generated/manifest.json")
local function nativeDag(app) = dagAt(app, "manifest.json")

// Forces the `output` block without reading ["dag"] — an extract-less contract has
// no extract node, which is the case that slipped past the in-node check.
local function forceOutput(app) = app.output.files!!.length

local appUiConfig = new App.UIConfig {
  tasks {
    ["Configuration"] {
      inputs {
        ["target"] = new App.TextInput {
          title = "Target"
          placeholderText = "my-target"
        }
      }
    }
  }
}

// ── App.pkl ───────────────────────────────────────────────────────────────

// Real-time streaming: opted in, batching left at the default (one event per DAG run).
local appStreamingRealtime = (App) {
  streamingWorkflowType = "example-app:cdc-stream"
  name = "app-streaming-realtime"
  displayName = "App Streaming Realtime"
  icon = "https://example.com/icon.svg"
  hasCredentialConfig = false
  uiConfig = appUiConfig
  pipeline { publish = null }

  events {
    new App.EventTriggerSpec {
      name = "cdc-user-entity"
      source = new App.EventSource {
        name = "atlan-kafka"
        topic = "app.cdc.user_entity"
      }
      triggerConfig = new App.EventTriggerConfig {
        streaming { enabled = true }
      }
    }
  }
}

local appNoStreaming = (App) {
  name = "app-no-streaming"
  displayName = "App No Streaming"
  icon = "https://example.com/icon.svg"
  hasCredentialConfig = false
  uiConfig = appUiConfig
  pipeline { publish = null }

  events {
    new App.EventTriggerSpec {
      name = "cdc-user-entity"
      source = new App.EventSource {
        name = "atlan-kafka"
        topic = "app.cdc.user_entity"
      }
      triggerConfig = new App.EventTriggerConfig {
        ackPaths { "$.extract.outputs.ack_path" }
      }
    }
  }
}

local appRealtimeCfg = appCfg(appStreamingRealtime)


local appNoStreamCfg = appCfg(appNoStreaming)

// ── NativeApp.pkl ─────────────────────────────────────────────────────────

local nativeStreamingRealtime = (NativeApp) {
  streamingWorkflowType = "native-app:cdc-stream"
  name = "native-streaming-realtime"
  displayName = "Native Streaming Realtime"
  connector = Connectors.API
  workflowTypeOverride = "native-test:extract"
  icon = "https://example.com/icon.svg"
  hasPublishStep = false
  hasPublishInputFields = false
  uiConfig { tasks {} }

  events {
    new NativeApp.EventTriggerSpec {
      name = "cdc-user-entity"
      source = new NativeApp.EventSource {
        name = "atlan-kafka"
        topic = "app.cdc.user_entity"
      }
      triggerConfig = new NativeApp.EventTriggerConfig {
        streaming { enabled = true }
      }
    }
  }
}

local nativeNoStreaming = (NativeApp) {
  name = "native-no-streaming"
  displayName = "Native No Streaming"
  connector = Connectors.API
  workflowTypeOverride = "native-test:extract"
  icon = "https://example.com/icon.svg"
  hasPublishStep = false
  hasPublishInputFields = false
  uiConfig { tasks {} }

  events {
    new NativeApp.EventTriggerSpec {
      name = "cdc-user-entity"
      source = new NativeApp.EventSource {
        name = "atlan-kafka"
        topic = "app.cdc.user_entity"
      }
      triggerConfig = new NativeApp.EventTriggerConfig {
        ackPaths { "$.extract.outputs.ack_path" }
      }
    }
  }
}

local nativeRealtimeCfg = nativeCfg(nativeStreamingRealtime)


local nativeNoStreamCfg = nativeCfg(nativeNoStreaming)

facts {
  ["App.pkl: streaming.enabled renders streaming_enabled = true"] {
    appRealtimeCfg["streaming_enabled"] == true
  }

  // AE bounds a micro-batch by BYTES, not by a count the contract picks, so there
  // is no size or timing knob to render. These keys existed for the signal-driven
  // shard and AE stopped reading them when that shell was deleted; a contract that
  // still emitted them would describe a queue the runtime does not have.
  ["App.pkl: no batch-size or timing keys are rendered at all"] {
    !appRealtimeCfg.containsKey("streaming_batch_size")
    !appRealtimeCfg.containsKey("streaming_batch_wait_seconds")
    !appRealtimeCfg.containsKey("streaming_events_per_signal")
  }

  ["App.pkl: streaming suppresses max_retries, keeps ack_paths well-formed"] {
    // max_retries is inert on the streaming path — AE's streaming_dispatch.py reads
    // neither it nor ack_paths — so it is not rendered at all. Shipping a key AE will
    // not act on leaves a contract author no way to tell which keys are live. AE
    // defaults it to 3 when absent.
    !appRealtimeCfg.containsKey("max_retries")
    // ackPaths left empty — AE rejects [], so the toolkit renders fire-and-forget [""].
    // Non-empty ackPaths WITH streaming is refused at eval time, so this is the only
    // shape the streaming path can produce.
    appRealtimeCfg["ack_paths"].length == 1
    appRealtimeCfg["ack_paths"][0] == ""
  }

  ["App.pkl: a non-streaming trigger emits NO streaming keys at all"] {
    appNoStreamCfg.toMap().keys == Set("max_retries", "ack_paths")
  }

  ["NativeApp.pkl: streaming.enabled renders streaming_enabled = true"] {
    nativeRealtimeCfg["streaming_enabled"] == true
  }

  ["NativeApp.pkl: no batch-size or timing keys are rendered at all"] {
    !nativeRealtimeCfg.containsKey("streaming_batch_size")
    !nativeRealtimeCfg.containsKey("streaming_batch_wait_seconds")
    !nativeRealtimeCfg.containsKey("streaming_events_per_signal")
  }

  ["NativeApp.pkl: streaming suppresses max_retries, keeps ack_paths well-formed"] {
    !nativeRealtimeCfg.containsKey("max_retries")
    nativeRealtimeCfg["ack_paths"].length == 1
    nativeRealtimeCfg["ack_paths"][0] == ""
  }

  ["NativeApp.pkl: a non-streaming trigger emits NO streaming keys at all"] {
    nativeNoStreamCfg.toMap().keys == Set("max_retries", "ack_paths")
  }

  // The ceiling is a measured cliff, not a style preference: past it the shard
  // builds a batch inside one workflow activation and risks Temporal's
  // non-configurable two-second deadlock budget, which fails the task
  // deterministically and therefore permanently. Caught at eval time so an
  // author cannot ship it.
  ["ackPaths declared alongside streaming is refused at eval time"] {
    module.catch(() -> new App.EventTriggerConfig {
      ackPaths { "$.extract.outputs.ack_path" }
      streaming { enabled = true }
    }._ackShapeCheck).contains("ackPaths is inert when streaming.enabled")
  }

  ["ackPaths alone (no streaming) is still allowed"] {
    (new App.EventTriggerConfig {
      ackPaths { "$.extract.outputs.ack_path" }
    })._ackShapeCheck == null
  }

  // max_retries is inert on the streaming path (AE's streaming_dispatch.py reads
  // neither max_retries nor ack_paths), so it must not be rendered — a contract
  // author has no other way to tell which manifest keys are live.
  ["max_retries is suppressed under streaming"] {
    !appRealtimeCfg.containsKey("max_retries")
  }

  ["max_retries is still rendered without streaming"] {
    appNoStreamCfg.containsKey("max_retries")
  }

  // The gap this closes, found end-to-end on a tenant: streaming was on, the DAG
  // still dispatched the batch workflow type with no events in its arguments, and
  // nothing errored — the shard ran and applied nothing.
  ["streaming DAG dispatches the streaming workflow type"] {
    appDag(appStreamingRealtime)["extract"]["inputs"]["workflow_type"] == "example-app:cdc-stream"
  }

  // Both keys, always. AE sends the events inline at `batch` only when the
  // serialised micro-batch fits its inline cap and sends `null` there when it does
  // not; `batch_key` is always the object-store key. A contract that wired only
  // `batch` applies nothing, silently, the first time a batch goes over the cap —
  // and Kafka has already been acked by then, so the events are simply gone.
  ["streaming DAG passes both the inline batch and its object-store key"] {
    appDag(appStreamingRealtime)["extract"]["inputs"]["args"]["batch"] == "$.event.batch"
    appDag(appStreamingRealtime)["extract"]["inputs"]["args"]["batch_key"] == "$.event.batch_key"
  }

  ["a non-streaming DAG keeps the batch workflow type and neither batch arg"] {
    appDag(appNoStreaming)["extract"]["inputs"]["workflow_type"] != "example-app:cdc-stream"
    !appDag(appNoStreaming)["extract"]["inputs"]["args"].containsKey("batch")
    !appDag(appNoStreaming)["extract"]["inputs"]["args"].containsKey("batch_key")
  }

  ["streaming without a streaming workflow type is refused"] {
    // Asserts the message: a bare `!= null` would pass identically if the throw
    // came from the `!!` on a null override rather than from the refusal.
    module.catch(() -> appDag((appStreamingRealtime) {
      streamingWorkflowType = null
    })).contains("no streamingWorkflowType")
  }

  ["both schemas render the same streaming shape"] {
    appRealtimeCfg == nativeRealtimeCfg
  }

  // ── An entrypoint renders ONE extract node, shared by every trigger on it, so
  // `workflow_type` is a property of the entrypoint. A streaming entrypoint's node
  // dispatches the streaming type and gains `args.batch`; anything else on it starts
  // that same node with nothing to apply, silently. Caught `examples/scheduled`,
  // which had three schedules and two batch triggers sharing a node with two
  // streaming triggers.

  ["a streaming entrypoint carrying a batch event trigger is refused"] {
    module.catch(() -> appDag((appStreamingRealtime) {
      events {
        new App.EventTriggerSpec {
          name = "cdc-batch-alongside"
          source = new App.EventSource {
            name = "atlan-kafka"
            topic = "app.cdc.batch"
          }
          triggerConfig = new App.EventTriggerConfig {}
        }
      }
    })).contains("mixes streaming and non-streaming event triggers")
  }

  ["a streaming entrypoint carrying a schedule is refused"] {
    module.catch(() -> appDag((appStreamingRealtime) {
      schedules {
        new App.ScheduleSpec {
          name = "nightly"
          cronExpression = "0 0 * * *"
        }
      }
    })).contains("schedule(s)")
  }

  // `pipeline { extract = null }` is a supported opt-out, and the refusals were
  // forced only inside generateExtractNode — so an extract-less contract rendered
  // streaming_enabled: true and threw nothing. Both schemas now force the check in
  // the output block as well. Reported by mothership-ai.
  // The mirror of the missing-workflow-type refusal: the type is declared and nothing
  // streams, so the node renders the batch type and the declared value is dropped.
  // Same "declared and inert" class as the batch knobs and ackPaths.
  ["a streaming workflow type with nothing streaming is refused"] {
    module.catch(() -> appDag((appNoStreaming) {
      streamingWorkflowType = "example-app:cdc-stream"
    })).contains("no event trigger has streaming.enabled")
  }

  ["App.pkl: streaming on an extract-less entrypoint is still refused"] {
    module.catch(() -> forceOutput((appStreamingRealtime) {
      pipeline { extract = null }
      streamingWorkflowType = null
    })).contains("streamingWorkflowType")
  }

  // No NativeApp equivalent: it has no `pipeline`, so the extract node is not
  // optional there and the in-node reference always fires. The output-block force is
  // still applied to both schemas to keep them in lockstep.

  // `batch` collides with a UI property of the same name in the extract-node args
  // mapping. Verified before the guard: a duplicate-key crash, not a silent override —
  // the same failure the app_name/agent_json/extraction_method guards prevent.
  ["a `batch` property does not collide with args.batch under streaming"] {
    let (withBatchProp = (appStreamingRealtime) {
      uiConfig = new App.UIConfig {
        tasks {
          ["Configuration"] {
            inputs { ["batch"] = new App.TextInput { title = "Batch" } }
          }
        }
      }
    })
      appDag(withBatchProp)["extract"]["inputs"]["args"]["batch"] == "$.event.batch"
  }

  // ``batch_key`` is reserved by the same mechanism and for the same reason: the
  // extract node emits it too, so a property of that name would land on the same
  // key. ``toPyName`` swaps ``-`` for ``_``, so ``batch-key`` reaches it as well.
  ["a `batch_key` property does not collide with args.batch_key under streaming"] {
    let (withKeyProp = (appStreamingRealtime) {
      uiConfig = new App.UIConfig {
        tasks {
          ["Configuration"] {
            inputs { ["batch-key"] = new App.TextInput { title = "Batch key" } }
          }
        }
      }
    })
      appDag(withKeyProp)["extract"]["inputs"]["args"]["batch_key"] == "$.event.batch_key"
  }

  ["a `batch_key` property is untouched without streaming"] {
    let (withKeyProp = (appNoStreaming) {
      uiConfig = new App.UIConfig {
        tasks {
          ["Configuration"] {
            inputs { ["batch-key"] = new App.TextInput { title = "Batch key" } }
          }
        }
      }
    })
      appDag(withKeyProp)["extract"]["inputs"]["args"]["batch_key"] == "{{batch-key}}"
  }

  ["a `batch` property is untouched without streaming"] {
    let (withBatchProp = (appNoStreaming) {
      uiConfig = new App.UIConfig {
        tasks {
          ["Configuration"] {
            inputs { ["batch"] = new App.TextInput { title = "Batch" } }
          }
        }
      }
    })
      appDag(withBatchProp)["extract"]["inputs"]["args"]["batch"] == "{{batch}}"
  }

  // The parity group above compares trigger_config only, never the extract node —
  // which is where the workflow-type split actually lands. Each schema renders its
  // OWN declared override, so the assertion is structural, not string equality.
  ["both schemas retarget the extract node the same way under streaming"] {
    appDag(appStreamingRealtime)["extract"]["inputs"]["workflow_type"]
      == "example-app:cdc-stream"
    nativeDag(nativeStreamingRealtime)["extract"]["inputs"]["workflow_type"]
      == "native-app:cdc-stream"
    appDag(appStreamingRealtime)["extract"]["inputs"]["args"]["batch"]
      == nativeDag(nativeStreamingRealtime)["extract"]["inputs"]["args"]["batch"]
    // Both args, both schemas: a batch that goes over the inline cap arrives as
    // `batch = null`, so a schema that rendered only `batch` would apply nothing
    // and report success.
    appDag(appStreamingRealtime)["extract"]["inputs"]["args"]["batch_key"]
      == nativeDag(nativeStreamingRealtime)["extract"]["inputs"]["args"]["batch_key"]
  }

  ["neither schema retargets the extract node without streaming"] {
    appDag(appNoStreaming)["extract"]["inputs"]["workflow_type"] != "example-app:cdc-stream"
    nativeDag(nativeNoStreaming)["extract"]["inputs"]["workflow_type"] != "native-app:cdc-stream"
    !nativeDag(nativeNoStreaming)["extract"]["inputs"]["args"].containsKey("batch")
    !nativeDag(nativeNoStreaming)["extract"]["inputs"]["args"].containsKey("batch_key")
  }
}
