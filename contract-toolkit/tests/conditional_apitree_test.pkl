// Tests for `ConditionalInput` with `baseWidgetType = "apitree"`.
//
// Background: the frontend renders a `type: "conditional"` property by
// spreading the base `ui` and then the matching condition's `ui`. With no
// match (direct mode) the apitree widget reads `ui.metadataTemplateKey` to load
// its tree. ConditionalInput used to have no way to emit that key, so a
// connector that wanted "apitree in direct mode, text input in agent mode" had
// to post-process the generated configmap. These tests pin the base `ui` keys
// for both the App.pkl (Widgets.pkl) and NativeApp.pkl (Config.pkl) paths.

amends "pkl:test"

import "pkl:json"
import "../src/App.pkl" as App
import "../src/Config.pkl"
import "../src/Connectors.pkl"
import "../src/Widgets.pkl" as Widgets

// Fixture rather than an example: the App.pkl path types an apitree value as
// `dict[str, Any]`, which the SDK's payload-safety check rejects at import, so
// an example would fail `scripts/test-sdk-import.py`. Rendering is unaffected.
local apiTreeApp = (App) {
  name = "conditional-apitree-test"
  displayName = "Conditional APITree Test"
  connector = Connectors.API
  icon = "https://example.com/icon.svg"
  credentialConnectorType = "rest"

  credentialAuthOptions {
    ["basic"] = new App.AuthOption {
      label = "Basic"
      fields {
        new App.FieldSpec { name = "username"; displayName = "Username" }
        new App.FieldSpec { name = "password"; displayName = "Password"; sensitive = true }
      }
    }
  }

  uiConfig = new App.UIConfig {
    tasks {
      ["Metadata"] {
        inputs {
          ["extraction-method"] = new App.ConditionalInput {
            title = "Extraction method"
            baseWidgetType = "radio"
            baseEnum { "direct"; "agent" }
            default = "direct"
          }
          // Apitree in direct mode; text input when extraction-method == "agent".
          ["include-folders"] = new App.ConditionalInput {
            title = "Include Folders"
            helpText = "Only selected folders will be crawled."
            baseWidgetType = "apitree"
            connectorConfig = "atlan-connectors-conditional-apitree-test"
            credentialRef = "credential-guid"
            metadataTemplateKey = "folders"
            width = 4
            default = new Mapping {}
            additionalProperties = new Dynamic { type = "array" }
            conditions {
              new App.Condition {
                property = "extraction-method"
                value = "agent"
                overrideUi = new Mapping<String, Any> {
                  ["widget"] = "input"
                  ["label"] = "Include Folders"
                  ["placeholder"] = #"{"^folder1$": [], "^folder2$": []}"#
                  ["grid"] = 4
                }
              }
            }
          }
        }
      }
    }
  }
}

local folders = new json.Parser { useMapping = true }.parse(
  apiTreeApp.output.files["app/generated/conditional-apitree-test.json"].text
)["config"]["properties"]["include-folders"]

local widgetsApiTree = new Widgets.ConditionalInput {
  title = "Include Projects"
  baseWidgetType = "apitree"
  connectorConfig = "atlan-connectors-example"
  credentialRef = "credential-guid"
  metadataTemplateKey = "projects"
  metadataTransformerTemplateKey = "projects-transformer"
  flatten = true
  strict = false
  multiSelect = true
}

local configApiTree = new Config.ConditionalInput {
  title = "Include Projects"
  baseWidgetType = "apitree"
  connectorConfig = "atlan-connectors-example"
  credentialRef = "credential-guid"
  metadataTemplateKey = "projects"
  metadataTransformerTemplateKey = "projects-transformer"
  flatten = true
  strict = false
  multiSelect = true
}

local widgetsSqlTree = new Widgets.ConditionalInput {
  title = "Include Metadata"
  baseWidgetType = "sqltree"
  sqlQuery = "show atlan schemas"
  multiSelect = true
}

local configSqlTree = new Config.ConditionalInput {
  title = "Include Metadata"
  baseWidgetType = "sqltree"
  sqlQuery = "show atlan schemas"
  multiSelect = true
}

facts {
  // -----------------------------------------------------------------------
  // End-to-end: the fixture app's generated workflow configmap.
  // -----------------------------------------------------------------------

  ["apitree base ui keeps metadataTemplateKey and credential wiring"] {
    folders["type"] == "conditional"
    folders["ui"]["widget"] == "apitree"
    folders["ui"]["metadataTemplateKey"] == "folders"
    folders["ui"]["connectorConfigName"] == "atlan-connectors-conditional-apitree-test"
    folders["ui"]["credential"] == "credential-guid"
    folders["additionalProperties"]["type"] == "array"
  }

  ["apitree agent-mode condition swaps in a text input"] {
    folders["conditions"][0]["property"] == "extraction-method"
    folders["conditions"][0]["value"] == "agent"
    folders["conditions"][0]["ui"]["widget"] == "input"
    !folders["conditions"][0]["ui"].containsKey("metadataTemplateKey")
  }

  // Unset apitree properties must not leak into the base ui.
  ["apitree base ui omits unset apitree keys"] {
    !folders["ui"].containsKey("metadataTransformerTemplateKey")
    !folders["ui"].containsKey("flattenValue")
    !folders["ui"].containsKey("treeCheckStrictly")
    !folders["ui"].containsKey("isMultiple")
    !folders["ui"].containsKey("multiple")
  }

  // -----------------------------------------------------------------------
  // Both ConditionalInput classes emit the same apitree keys.
  // -----------------------------------------------------------------------

  ["Widgets.ConditionalInput apitree emits every APITree ui key"] {
    widgetsApiTree.ui.metadataTemplateKey == "projects"
    widgetsApiTree.ui.metadataTransformerTemplateKey == "projects-transformer"
    widgetsApiTree.ui.flattenValue == true
    widgetsApiTree.ui.treeCheckStrictly == false
    widgetsApiTree.ui.isMultiple == true
    widgetsApiTree.ui.multiple == null
    widgetsApiTree.outputValueType == "object"
  }

  ["Config.ConditionalInput apitree emits every APITree ui key"] {
    configApiTree.ui.metadataTemplateKey == "projects"
    configApiTree.ui.metadataTransformerTemplateKey == "projects-transformer"
    configApiTree.ui.flattenValue == true
    configApiTree.ui.treeCheckStrictly == false
    configApiTree.ui.isMultiple == true
    configApiTree.ui.multiple == null
    configApiTree.outputValueType == "object"
  }

  // -----------------------------------------------------------------------
  // Backward compatibility: sqltree keeps `multiple`, never `isMultiple`.
  // -----------------------------------------------------------------------

  ["sqltree multiSelect still emits multiple, not isMultiple"] {
    widgetsSqlTree.ui.multiple == true
    widgetsSqlTree.ui.isMultiple == null
    widgetsSqlTree.ui.metadataTemplateKey == null
    configSqlTree.ui.multiple == true
    configSqlTree.ui.isMultiple == null
    configSqlTree.ui.metadataTemplateKey == null
  }
}
