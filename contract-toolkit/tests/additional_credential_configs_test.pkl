// FND-4755: `additionalCredentialConfigs` lets one contract emit more than one
// credential configmap. `CredentialConfig.wrapper` and `.identityProperties`
// independently drop the envelope keys and the hidden identity properties, so a
// legacy config can be reproduced exactly (`{"config": {properties, anyOf}}` only,
// or the envelope without identity properties as Credential.pkl rendered it). Each renders through the same
// renderer as the primary `<connectorConfigName>.json`; a bundle hoists and
// dedupes them like the primary.

amends "pkl:test"

import "pkl:json"

import "../examples/credential-configs/app.pkl" as bundle
import "../examples/credential-configs/export.pkl" as export
import "../examples/credential-configs/report.pkl" as report
import "../examples/credential-configs/objectstore.pkl" as objectstore
import "../examples/minimal/app.pkl" as minimalApp
import "../src/App.pkl" as App

local function parsed(m: Module, path: String): Mapping =
  (new json.Parser { useMapping = true }.parse(m.output.files[path].text) as Mapping)

local objectstorePath = "app/generated/csa-connectors-objectstore.json"
local deliveryPath = "app/generated/atlan-connectors-credential-configs-delivery.json"

local bare = parsed(report, objectstorePath)
local bareProps = bare["config"]["properties"] as Mapping
local wrapped = parsed(export, deliveryPath)
local bundleFiles = bundle.output.files.keys

local function withExtra(base: Module, c: App.CredentialConfig) = (base) {
  additionalCredentialConfigs { c }
}

local extra = new App.CredentialConfig {
  name = "atlan-connectors-export-extra"
  authOptions { ["basic"] = new App.AuthOption { label = "Basic"; fields {} } }
}

local function err(m: Module): String = module.catch(() -> m.output.files)

facts {
  ["A bare config is only `config`: no wrapper keys, no hidden identity properties"] {
    bare.keys == Set("config")
    bare["config"].keys == Set("properties", "anyOf")
    !bareProps.containsKey("name")
    !bareProps.containsKey("connector")
    !bareProps.containsKey("connectorType")
    bareProps.keys == Set("auth-type", "s3", "gcs", "adls")
  }

  ["A bare config keeps the auth-type radio and anyOf rules of the shared renderer"] {
    bareProps["auth-type"]["enum"].toList() == List("s3", "gcs", "adls")
    bareProps["auth-type"]["default"] == "s3"
    bareProps["auth-type"]["ui"]["label"] == "Cloud object store"
    bareProps["auth-type"]["ui"]["grid"] == 8
    bare["config"]["anyOf"].toList().map((r) -> r["properties"]["auth-type"]["const"]) == List("s3", "gcs", "adls")
  }

  ["AuthOption nestedHelp / nestedWidth render on the pane; unset they are omitted"] {
    bareProps["s3"]["ui"]["help"] == "Details for accessing information from Amazon S3."
    bareProps["s3"]["ui"]["grid"] == 8
    !wrapped["config"]["properties"]["s3"]["ui"].containsKey("help")
    !wrapped["config"]["properties"]["s3"]["ui"].containsKey("grid")
  }

  ["A wrapped additional config carries the wrapper and falls back to the app's connector"] {
    wrapped["connector"] == "s3"
    wrapped["defaultConnectorType"] == "rest"
    wrapped["icon"] == export.icon
    wrapped["config"]["properties"].containsKey("name")
    wrapped["config"]["properties"].containsKey("connectorType")
  }

  ["A contract emits its primary and every additional config side by side"] {
    export.output.files.containsKey("app/generated/atlan-connectors-credential-configs.json")
    export.output.files.containsKey(deliveryPath)
    export.output.files.containsKey(objectstorePath)
  }

  ["hasCredentialConfig = false still emits additional configs, and no primary"] {
    report.output.files.containsKey(objectstorePath)
    !report.output.files.containsKey("app/generated/atlan-connectors-report.json")
  }

  ["A bundle hoists additional configs to app/generated/ and dedupes identical ones"] {
    bundleFiles.contains(objectstorePath)
    bundleFiles.contains(deliveryPath)
    bundleFiles.contains("app/generated/atlan-connectors-credential-configs.json")
    !bundleFiles.any((f) -> f.endsWith("/csa-connectors-objectstore.json") && f != objectstorePath)
    bundle.output.files[objectstorePath].text == report.output.files[objectstorePath].text
  }

  ["The shared object-store config is the same value both entrypoints list"] {
    report.additionalCredentialConfigs.toList().first.name == objectstore.config.name
  }

  ["Without additionalCredentialConfigs the output is unchanged"] {
    minimalApp.additionalCredentialConfigs.isEmpty
    !minimalApp.output.files.keys.any((f) -> f.contains("-extra"))
  }

  ["A name without a credential-template prefix is refused"] {
    err(withExtra(export, (extra) { name = "export-extra" })).contains("lowercase kebab-case")
  }

  ["A name with path characters is refused"] {
    err(withExtra(export, (extra) { name = "csa-connectors-x/../../evil" })).contains("lowercase kebab-case")
    err(withExtra(export, (extra) { name = "atlan-connectors-Export" })).contains("lowercase kebab-case")
  }

  ["A bundle root declaring additional configs is refused, not silently dropped"] {
    err((bundle) {
      additionalCredentialConfigs { (extra) { wrapper = false } }
      uiConfig = report.uiConfig
    }).contains("bundle root")
  }

  ["An additional config that differs from another entrypoint's same-named file is refused"] {
    err((bundle) {
      entrypoints {
        new App.Entrypoint {
          name = "clash"
          contract = withExtra(report, (extra) { name = export.connectorConfigName; wrapper = false })
        }
      }
    }).contains("different content")
  }

  ["A name declared twice is refused"] {
    err((export) { additionalCredentialConfigs { extra; extra } }).contains("more than once")
  }

  ["A name that collides with the primary config is refused"] {
    err(withExtra(export, (extra) { name = export.connectorConfigName })).contains("collide")
  }

  ["A contract with no uiConfig is refused"] {
    err((withExtra(report, extra)) { uiConfig = null }).contains("no uiConfig")
  }

  ["A wrapped config with no connector anywhere is refused; one without the envelope is not"] {
    err(withExtra(report, extra)).contains("no connector")
    withExtra(report, (extra) { wrapper = false })
      .output.files.containsKey("app/generated/atlan-connectors-export-extra.json")
  }

  ["The envelope and the identity properties are independent switches"] {
    let (envOnly = parsed(withExtra(export, (extra) { identityProperties = false }), "app/generated/atlan-connectors-export-extra.json"))
      envOnly.containsKey("defaultConnectorType")
        && !envOnly["config"]["properties"].containsKey("name")
        && !envOnly["config"]["properties"].containsKey("connectorType")
    let (idOnly = parsed(withExtra(export, (extra) { wrapper = false }), "app/generated/atlan-connectors-export-extra.json"))
      idOnly.keys == Set("config") && idOnly["config"]["properties"].containsKey("connectorType")
  }

  ["Fields a flag makes unused are refused rather than ignored"] {
    err(withExtra(export, (extra) { wrapper = false; icon = "x" })).contains("only the envelope carries")
    err(withExtra(export, (extra) { wrapper = false; connectorType = "jdbc" })).contains("only the envelope carries")
    err(withExtra(export, (extra) { identityProperties = false; connectorDefault = "s3" })).contains("only the hidden")
    err(withExtra(export, (extra) { identityProperties = false; namePlaceholder = "Host" })).contains("only the hidden")
  }
}
