{
  "execution_mode": "automation-engine",
  "dag": {
    "extract": {
      "activity_name": "execute_workflow",
      "activity_display_name": "Extract Scheduled Background Job Example Metadata",
      "app_name": "scheduled",
      "inputs": {
        "workflow_type": "example-app:cdc-stream",
        "app_name": "scheduled",
        "app_id": "",
        "argo_workflow_slug": "",
        "task_queue": "atlan-scheduled-{deployment_name}",
        "args": {
          "batch": "$.event.batch",
          "app_name": "scheduled",
          "credential": "{{credential}}",
          "agent_json": "{{agent-json}}",
          "extraction_method": "{{extraction-method}}",
          "target": "{{target}}"
        }
      },
      "error_handling": {
        "start_to_close_timeout_seconds": 86400
      }
    }
  },
  "triggers": {
    "schedules": [
      {
        "name": "daily-midnight",
        "cron_expression": "0 0 * * *",
        "timezone": "UTC",
        "status": "ACTIVE"
      },
      {
        "name": "weekday-noon-et",
        "cron_expression": "0 12 * * 1-5",
        "timezone": "America/New_York",
        "status": "ACTIVE"
      },
      {
        "name": "six-hourly-disabled",
        "cron_expression": "0 */6 * * *",
        "timezone": "UTC",
        "status": "PAUSED"
      }
    ],
    "events": [
      {
        "name": "cdc-user-entity",
        "source": {
          "name": "atlan-kafka",
          "topic": "example.cdc.user_entity"
        },
        "trigger_config": {
          "max_retries": 3,
          "ack_paths": [
            "$.extract.outputs.ack_path"
          ]
        },
        "status": "ACTIVE"
      },
      {
        "name": "cdc-group-disabled",
        "source": {
          "name": "atlan-kafka",
          "topic": "example.cdc.group"
        },
        "trigger_config": {
          "max_retries": 3,
          "ack_paths": [
            ""
          ]
        },
        "status": "PAUSED"
      },
      {
        "name": "cdc-user-streaming",
        "source": {
          "name": "atlan-kafka",
          "topic": "example.cdc.user_realtime"
        },
        "trigger_config": {
          "ack_paths": [
            ""
          ],
          "streaming_enabled": true,
          "streaming_batch_size": 1,
          "streaming_batch_wait_seconds": 0,
          "streaming_events_per_signal": 500
        },
        "status": "ACTIVE"
      },
      {
        "name": "cdc-audit-streaming-batched",
        "source": {
          "name": "atlan-kafka",
          "topic": "example.cdc.audit"
        },
        "trigger_config": {
          "ack_paths": [
            ""
          ],
          "streaming_enabled": true,
          "streaming_batch_size": 200,
          "streaming_batch_wait_seconds": 2,
          "streaming_events_per_signal": 500
        },
        "status": "ACTIVE"
      }
    ]
  }
}
