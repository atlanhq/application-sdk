{
  "execution_mode": "automation-engine",
  "dag": {
    "extract": {
      "activity_name": "execute_workflow",
      "activity_display_name": "Extract Tree Filters Example Metadata",
      "app_name": "tree-filters",
      "inputs": {
        "workflow_type": "tree-filters",
        "app_name": "tree-filters",
        "app_id": "",
        "argo_workflow_slug": "",
        "task_queue": "atlan-tree-filters-{deployment_name}",
        "args": {
          "app_name": "tree-filters",
          "credential": "{{credential}}",
          "agent_json": "{{agent-json}}",
          "extraction_method": "{{extraction-method}}",
          "include_filter": "{{include-filter}}",
          "exclude_filter": "{{exclude-filter}}"
        }
      },
      "error_handling": {
        "start_to_close_timeout_seconds": 86400
      }
    }
  }
}
