{
  "icon": "https://assets.atlan.com/assets/download.svg",
  "helpdeskLink": "",
  "logo": "https://assets.atlan.com/assets/download.svg",
  "connector": "s3",
  "defaultConnectorType": "rest",
  "config": {
    "properties": {
      "name": {
        "type": "string",
        "required": false,
        "ui": {
          "label": "Name",
          "hidden": true,
          "placeholder": "Host Name"
        }
      },
      "connector": {
        "type": "string",
        "required": false,
        "ui": {
          "label": "Connector",
          "hidden": true,
          "placeholder": "Connector"
        }
      },
      "connectorType": {
        "type": "string",
        "required": false,
        "ui": {
          "key": "_host",
          "label": "connectorType",
          "placeholder": "connectorType",
          "hidden": true
        }
      },
      "auth-type": {
        "type": "string",
        "enum": [
          "s3",
          "email"
        ],
        "default": "s3",
        "required": true,
        "enumNames": [
          "S3",
          "Email"
        ],
        "ui": {
          "widget": "radio",
          "hidden": false,
          "label": "Output destination"
        }
      },
      "s3": {
        "type": "object",
        "ui": {
          "widget": "nested",
          "label": "S3 bucket",
          "hidden": false,
          "nestedValue": false
        },
        "properties": {
          "username": {
            "type": "string",
            "ui": {
              "widget": "input",
              "label": "AWS access key",
              "hidden": false,
              "grid": 6
            }
          },
          "password": {
            "type": "string",
            "ui": {
              "widget": "password",
              "label": "AWS secret key",
              "hidden": false,
              "grid": 6
            }
          },
          "extra": {
            "type": "object",
            "ui": {
              "widget": "nested",
              "label": "",
              "header": "Advanced",
              "hidden": false
            },
            "properties": {
              "s3-bucket-name": {
                "type": "string",
                "required": true,
                "ui": {
                  "widget": "input",
                  "label": "S3 bucket name",
                  "hidden": false,
                  "placeholder": "my-bucket",
                  "grid": 4
                }
              }
            }
          }
        }
      },
      "email": {
        "type": "object",
        "ui": {
          "widget": "nested",
          "label": "Email",
          "hidden": false,
          "nestedValue": false
        },
        "properties": {
          "extra": {
            "type": "object",
            "ui": {
              "widget": "nested",
              "label": "",
              "header": "Advanced",
              "hidden": false
            },
            "properties": {
              "recipients": {
                "type": "string",
                "required": true,
                "ui": {
                  "widget": "input",
                  "label": "Recipients",
                  "hidden": false,
                  "placeholder": "a@example.com",
                  "grid": 8
                }
              }
            }
          }
        }
      }
    },
    "anyOf": [
      {
        "properties": {
          "auth-type": {
            "const": "s3"
          }
        },
        "required": [
          "s3"
        ]
      },
      {
        "properties": {
          "auth-type": {
            "const": "email"
          }
        },
        "required": [
          "email"
        ]
      }
    ]
  }
}
