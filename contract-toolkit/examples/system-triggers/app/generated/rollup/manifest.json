{
  "execution_mode": "automation-engine",
  "dag": {
    "extract": {
      "activity_name": "execute_workflow",
      "activity_display_name": "Extract Rollup Metadata",
      "app_name": "rollup",
      "inputs": {
        "workflow_type": "rollup",
        "app_name": "rollup",
        "app_id": "",
        "argo_workflow_slug": "",
        "task_queue": "atlan-rollup-{deployment_name}",
        "args": {
          "app_name": "rollup",
          "credential": "{{credential}}",
          "agent_json": "{{agent-json}}",
          "extraction_method": "{{extraction-method}}",
          "window_days": "{{window-days}}"
        }
      },
      "error_handling": {
        "start_to_close_timeout_seconds": 86400
      }
    }
  },
  "triggers": {
    "schedules": [
      {
        "name": "nightly",
        "cron_expression": "0 2 * * *",
        "timezone": "UTC",
        "status": "ACTIVE"
      }
    ]
  }
}
